{
  "name": "deepseek-harness-desktop",
  "productName": "DeepSeek",
  "version": "1.0.1",
  "description": "DeepSeek Harness Web UI 的 Linux 桌面壳（Electron + 内置 Node/dsh 运行时）",
  "main": "src/main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "Condex",
  "scripts": {
    "start": "DSH_DESKTOP_DEV=1 electron .",
    "dist": "electron-builder --linux AppImage tar.gz",
    "pack": "electron-builder --dir",
    "smoke": "node test/server-manager.test.js"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.deepseek.desktop",
    "productName": "DeepSeek",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/splash.html",
      "assets/whale.png",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons",
      "category": "Utility",
      "artifactName": "DeepSeek-${version}-${arch}.${ext}",
      "executableName": "deepseek",
      "synopsis": "DeepSeek Harness Desktop",
      "syncDesktopName": true
    }
  },
  "desktopName": "deepseek.desktop"
}
